APP_NAME=DataOps Sentinel AI
SERVICE_HOST=0.0.0.0

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=4096

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_URL=
QDRANT_LOCAL_PATH=qdrant_storage
QDRANT_COLLECTION=sentinel_knowledge
RAG_TOP_K=3

MCP_SERVER_URL=http://127.0.0.1:8100/mcp
A2A_DATA_AGENT_URL=http://127.0.0.1:8201
A2A_KNOWLEDGE_AGENT_URL=http://127.0.0.1:8202
VALIDATION_MAX_RETRIES=1

SPACY_MODEL=en_core_web_sm
PII_SCORE_THRESHOLD=0.35

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

OTEL_SERVICE_NAME=dataops-sentinel-ai
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

