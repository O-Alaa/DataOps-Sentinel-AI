APP_NAME=DataOps Sentinel AI
SERVICE_HOST=0.0.0.0

# -------------------------
# LLM profile
# -------------------------
# Local default:
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=4096

# Managed-cloud alternative:
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b

# -------------------------
# Retrieval
# -------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BACKEND=sentence_transformers

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=qdrant_storage
QDRANT_COLLECTION=sentinel_knowledge
RAG_TOP_K=3
RAG_AUTO_INGEST=false
RAG_RECREATE_ON_START=false

# -------------------------
# MCP + A2A
# -------------------------
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
A2A_DATA_AGENT_URL=http://127.0.0.1:8201
A2A_KNOWLEDGE_AGENT_URL=http://127.0.0.1:8202
VALIDATION_MAX_RETRIES=1

# -------------------------
# Security / NLP
# -------------------------
SPACY_MODEL=en_core_web_sm
PII_SCORE_THRESHOLD=0.35
API_AUTH_KEY=

# -------------------------
# Speech
# -------------------------
STT_PROVIDER=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# Cloud STT alternative:
# STT_PROVIDER=groq
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# -------------------------
# Observability / UI
# -------------------------
OTEL_SERVICE_NAME=dataops-sentinel-ai
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
API_BASE_URL=http://localhost:8000
